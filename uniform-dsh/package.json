{
  "name": "uniform-dsh",
  "version": "0.1.0",
  "description": "Drive a Uniform DGX Spark platform from DeepSeek Harness: deploy models, watch progress, read logs and GPU metrics.",
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@deepseek-ai/* --outfile=dist/index.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && git diff --exit-code -- dist && npm test"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-experimental-claude-code-mods": ">=0.2.1-alpha.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-experimental-claude-code-mods": "0.2.1-alpha.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
